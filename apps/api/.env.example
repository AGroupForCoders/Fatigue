# Copy to .env and fill in. Wrangler reads .env for local dev, and drizzle-kit reads it for migrations.

# A Postgres connection string. Local Docker Postgres, or a Neon branch.
DATABASE_URL=postgres://fatigue:fatigue@localhost:5432/fatigue

# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where this API is reachable. The iOS simulator can reach localhost directly.
BETTER_AUTH_URL=http://localhost:8787

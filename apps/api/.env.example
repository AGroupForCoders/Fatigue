# Copy to .env and fill in. Wrangler reads .env for local dev, and drizzle-kit reads it for migrations.

# A Postgres connection string. Local Docker Postgres, or a Neon branch pasted as Neon gives it.
DATABASE_URL=postgres://fatigue:fatigue@localhost:5432/fatigue

# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where this API is reachable. The iOS simulator can reach localhost directly.
# The links in reset and verification emails point here, so in production it must be the public URL.
BETTER_AUTH_URL=http://localhost:8787

# Resend API key for reset and verification emails. Leave empty and emails are printed to the
# Wrangler log instead, link included, which is all local dev needs.
RESEND_API_KEY=

# Who the emails come from. Must be on a domain verified in Resend. Required once RESEND_API_KEY is set.
EMAIL_FROM=Fatigue <no-reply@example.com>

# The iOS app's URL scheme. The landing pages hand off to it. Defaults to fatigue.
APP_DEEP_LINK_SCHEME=fatigue

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fatigue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // postgres.js needs Node's net and crypto modules, which Workers provide behind this flag.
  "compatibility_flags": ["nodejs_compat"],
  // Serve the Worker on our own domain. Cloudflare makes the DNS record and certificate on deploy. It must match
  // BETTER_AUTH_URL and the iOS app's APIConfig.productionBaseURL; release builds only know this one URL.
  "routes": [{ "pattern": "api.fatigue.agroupforcoders.com", "custom_domain": true }],
  // One public URL only, so nothing signs in through a second address Better Auth doesn't expect.
  "workers_dev": false,
  // Once a day, delete photos and videos nobody can see any more (src/modules/posts/media.service.ts, cleanUp).
  "triggers": { "crons": ["17 15 * * *"] },
  // Keep request logs and errors in the Cloudflare dashboard. Workers Logs is included on the paid plan.
  "observability": { "enabled": true },
  // Readable stack traces in those logs.
  "upload_source_maps": true,
  // Settings that are the same everywhere. Everything else, secret or not, lives in the GitHub `production`
  // environment and goes up with each deploy (see .github/workflows/deploy-api.yml). Locally, .env sets it all.
  "vars": {
    "APP_DEEP_LINK_SCHEME": "fatigue"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fatigue-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // postgres.js needs Node's net and crypto modules, which Workers provide behind this flag.
  "compatibility_flags": ["nodejs_compat"],
  // Serve the Worker at https://fatigue-api.<account>.workers.dev until there is a custom domain.
  "workers_dev": true,
  // Keep request logs and errors in the Cloudflare dashboard. Workers Logs is included on the paid plan.
  "observability": { "enabled": true },
  // Readable stack traces in those logs.
  "upload_source_maps": true,
  // Settings that are the same everywhere. Everything else, secret or not, lives in the GitHub `production`
  // environment and goes up with each deploy (see .github/workflows/deploy-api.yml). Locally, .env sets it all.
  "vars": {
    "APP_DEEP_LINK_SCHEME": "fatigue"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The fatigue:// scheme. The pages the reset and verification emails land on open the app with it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.agroupforcoders.fatigue</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fatigue</string>
			</array>
		</dict>
	</array>
	<!-- Asked when the gym picker opens, to list gyms nearby. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fatigue shows the gyms near you so you can mark where you trained. Your location isn't saved, only the gym you pick.</string>
</dict>
</plist>
